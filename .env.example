# Replace these values with your own keys

# Coding agent (Claude Agent SDK) and research_agent (ChatAnthropic) both use
# this same Anthropic account/key. research_agent runs against Anthropic's
# hosted API directly rather than local Ollama - mistral-small3.2:24b
# demonstrably invented tool-call kwargs against two independently-correct
# schemas, a reliability gap worth paying for given research_agent's
# multi-tool orchestration (web_search, call_code_agent, deepagents' own
# task tool).
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-sonnet-5
RESEARCH_AGENT_MODEL=claude-haiku-4-5-20251001

# NVIDIA API key for weather_agent, which runs against NVIDIA's hosted API
# (ChatNVIDIA) rather than local Ollama - see docs/BUG_WEATHER_TOOL_SELECTION.md
# for why local models struggled with this agent's tool-heavy prompts.
NVIDIA_API_KEY=your_nvidia_api_key
WEATHER_AGENT_MODEL=z-ai/glm-5.2

# Local Ollama models (must be pulled and served by `ollama serve`, default
# http://localhost:11434) - each of these Ollama-backed agents has its own
# independent model, so you can tune them separately.
ORCHESTRATOR_MODEL=gpt-oss:20b
CONTENT_AGENT_MODEL=gpt-oss:20b

# LLM-semantic observability (prompts/completions/cost) for the LangChain-based
# agents - content_agent and research_agent. Leave blank to disable; Jaeger
# tracing below works independently of this. Get keys at cloud.langfuse.com
# (or your self-hosted instance's project settings).
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

AGENT_STORAGE_DIR=./storage
AGENT_CHECKPOINT_DB=./state/checkpoint.sqlite
ADK_DEV_UI=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service topology - the orchestrator calls these over A2A/HTTP.
CODE_AGENT_HOST=localhost
CODE_AGENT_PORT=8001
CODE_AGENT_URL=http://localhost:8001

RESEARCH_AGENT_HOST=localhost
RESEARCH_AGENT_PORT=8002
RESEARCH_AGENT_URL=http://localhost:8002

WEATHER_AGENT_HOST=localhost
WEATHER_AGENT_PORT=8003
WEATHER_AGENT_URL=http://localhost:8003

ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_URL=http://localhost:8000

# Which orchestrator implementation `uv run orchestrator` actually starts:
# "adk" (default) - existing ADK session-REST-API orchestrator, kept as-is.
# "langgraph" - A2A-native alternative (same JSON-RPC shape as the other 3
# agents) that sidesteps BUG_ORCHESTRATOR_RESUME.md's broken resume-through-
# RemoteA2aAgent by reusing the mesh's own interrupt()/checkpointer pattern.
# See docs/curl_commands.md scenario 3 - the two backends use different API
# shapes, so test commands differ depending on which one is running.
ORCHESTRATOR_BACKEND=adk
